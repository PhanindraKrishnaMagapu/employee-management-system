# Copy this file to BACKEND/.env and replace the placeholders.
# Never commit .env. It is listed in .gitignore.

# Used to sign the Flask session cookie. Use a long random string.
FLASK_SECRET_KEY=replace-with-a-long-random-string

# SQLite file path. Relative paths are resolved from the BACKEND folder.
# Phase 2 creates this file. Do not commit it.
DATABASE_PATH=database/ems.sqlite

# development or production
FLASK_ENV=development
